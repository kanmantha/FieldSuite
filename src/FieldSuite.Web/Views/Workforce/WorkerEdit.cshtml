@model FieldSuite.Web.ViewModels.WorkerFormViewModel
@{
    ViewData["Title"] = "Edit worker";
}

<h4 class="fw-bold mb-3">Edit worker</h4>

<div class="card" style="max-width: 760px;">
    <div class="card-body">
        <form asp-action="WorkerEdit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Full name *</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Job title</label>
                    <input asp-for="JobTitle" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hire date</label>
                    <input asp-for="HireDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Shift</label>
                    <select asp-for="Shift" asp-items="Html.GetEnumSelectList<FieldSuite.Domain.Common.ShiftType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contractor</label>
                    <select name="ContractorCompanyId" class="form-select">
                        <option value="">— Direct hire —</option>
                        @foreach (var contractor in Model.Contractors)
                        {
                            <option value="@contractor.Id" selected="@(Model.ContractorCompanyId == contractor.Id ? "selected" : null)">@contractor.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ContractorCompanyId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="WorkerDetails" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
