@model IEnumerable<FieldSuite.Web.ViewModels.EstimateListItemViewModel>
@using FieldSuite.Domain.Common
@using FieldSuite.Web.ViewModels
@{
    ViewData["Title"] = "Estimates";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a class="btn btn-primary" asp-action="Create">+ New estimate</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Title</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Valid Until</th>
                        <th class="text-end">Grand Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Reference</td>
                            <td>@e.Title</td>
                            <td>@e.ClientName</td>
                            <td><span class="badge bg-secondary">@e.Status</span></td>
                            <td>@(e.ValidUntil?.ToString("yyyy-MM-dd"))</td>
                            <td class="text-end" style="font-variant-numeric: tabular-nums">@e.GrandTotal.ToString("N2")</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@e.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
