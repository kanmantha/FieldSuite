@model FieldSuite.Domain.Entities.Project
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">@Model.Name <span class="badge bg-secondary">@Model.Code</span></h4>
        <span class="text-muted small">@Model.ClientName · @Model.Address</span>
    </div>
    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="kpi-card warning"><div class="kpi-label">Open / pending permits</div><div class="kpi-value">@ViewBag.ActivePermits</div></div></div>
    <div class="col-md-3"><div class="kpi-card @(ViewBag.OpenSnags > 0 ? "danger" : "success")"><div class="kpi-label">Open snags</div><div class="kpi-value">@ViewBag.OpenSnags</div></div></div>
    <div class="col-md-3"><div class="kpi-card @(ViewBag.OpenIncidents > 0 ? "danger" : "success")"><div class="kpi-label">Open incidents</div><div class="kpi-value">@ViewBag.OpenIncidents</div></div></div>
    <div class="col-md-3"><div class="kpi-card info"><div class="kpi-label">Attendance today</div><div class="kpi-value">@ViewBag.TodayAttendance</div></div></div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Details</div>
            <div class="card-body">
                <div class="row mb-2"><div class="col-4 detail-label">Status</div><div class="col-8"><span class="badge bg-@(Model.IsActive ? "success" : "secondary")">@Model.Status</span></div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Start</div><div class="col-8">@(Model.StartDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                <div class="row mb-2"><div class="col-4 detail-label">End</div><div class="col-8">@(Model.EndDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Client</div><div class="col-8">@Model.ClientName</div></div>
                <div class="row"><div class="col-4 detail-label">Address</div><div class="col-8">@Model.Address</div></div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Jump to module</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary btn-sm" asp-controller="Safety" asp-action="Index">Safety</a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Quality" asp-action="Index">Quality</a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Permits" asp-action="Index">Permits</a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Estimation" asp-action="Index">Estimation</a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Workforce" asp-action="Index">Workforce</a>
            </div>
        </div>
    </div>
</div>
