@model FieldSuite.Web.ViewModels.IncidentEditVm
@{
    ViewData["Title"] = "Edit incident";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Edit incident</h4>
        <span class="text-muted small">Only draft or reported incidents can be edited</span>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="IncidentDetails" asp-route-id="@Model.Id">Back</a>
</div>

<div class="card" style="max-width: 880px;">
    <div class="card-body">
        <form asp-action="IncidentEdit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Project *</label>
                    <select asp-for="ProjectId" class="form-select">
                        @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Projects)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                    <span asp-validation-for="ProjectId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Type</label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<IncidentType>()" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Severity *</label>
                    <select asp-for="Severity" asp-items="Html.GetEnumSelectList<Severity>()" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label class="form-label">Title *</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">What happened?</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Location *</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Occurred at (UTC)</label>
                    <input asp-for="OccurredAt" type="datetime-local" class="form-control" value="@Model.OccurredAt.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="OccurredAt" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Root cause (initial)</label>
                    <textarea asp-for="RootCause" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="IncidentDetails" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
