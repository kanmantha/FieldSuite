@model IReadOnlyList<FieldSuite.Web.Controllers.DocumentItem>
@{
    ViewData["Title"] = "User Documents";
}

<div class="page-head d-flex justify-content-between align-items-end gap-3">
    <div>
        <h2 class="page-title">User Documents</h2>
        <span class="page-sub">Short guides covering FieldSuite's functionality</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-muted">No documents available yet.</div></div>
}

<div class="row g-3">
    @foreach (var d in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start gap-3">
                        <span class="doc-icon"><i class="bi bi-file-earmark-pdf"></i></span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@d.Title</div>
                            <div class="small text-muted">@d.FileName · @d.SizeKb KB</div>
                            <div class="small text-muted">Updated @d.ModifiedUtc.ToString("dd MMM yyyy") UTC</div>
                        </div>
                    </div>
                    <div class="mt-auto pt-3 d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-primary" href="@Url.Content($"~/docs/{d.FileName}")" download="@d.FileName"><i class="bi bi-download me-1"></i>Download</a>
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Content($"~/docs/{d.FileName}")" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>Open</a>
                        @if (!string.IsNullOrEmpty(d.VideoUrl))
                        {
                            <a class="btn btn-sm btn-outline-danger" href="@d.VideoUrl" target="_blank"><i class="bi bi-play-btn me-1"></i>AI Video (YouTube)</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>