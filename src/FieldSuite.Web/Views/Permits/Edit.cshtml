@model FieldSuite.Web.ViewModels.PermitFormViewModel
@{
    ViewData["Title"] = "Edit work permit";
}

<h4 class="fw-bold mb-3">Edit work permit</h4>

<div class="card" style="max-width: 880px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.PermitId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Project *</label>
                    <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select"></select>
                    <span asp-validation-for="ProjectId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Permit type</label>
                    <input type="hidden" name="Type" value="@Model.Type" />
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<FieldSuite.Domain.Common.PermitType>()" class="form-select" disabled></select>
                    <span class="form-text small text-muted">Type cannot be changed after creation.</span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Title *</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Location *</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Requested start (UTC)</label>
                    <input asp-for="RequestedStart" type="datetime-local" class="form-control" value="@Model.RequestedStart.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Requested end (UTC)</label>
                    <input asp-for="RequestedEnd" type="datetime-local" class="form-control" value="@Model.RequestedEnd.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="RequestedEnd" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsolationVerified" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="IsolationVerified">Energy / isolation verified</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="GasTestRequired" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="GasTestRequired">Atmosphere / gas test required</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Special conditions</label>
                    <textarea asp-for="SpecialConditions" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@ViewBag.PermitId">Cancel</a>
            </div>
        </form>
    </div>
</div>