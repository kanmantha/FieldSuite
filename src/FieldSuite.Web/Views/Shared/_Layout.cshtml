@using FieldSuite.Web.Services
@inject ICurrentUser Current
@{
    var initials = string.Concat((Current.FullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2).Select(p => p[0])).ToUpperInvariant();
    var title = ViewData["Title"]?.ToString() ?? "FieldSuite";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1a2e" />
    <meta name="description" content="FieldSuite — safety, quality, permits, estimation and workforce operations for construction SMEs." />
    <title>@title — FieldSuite</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
@if (Current.IsAuthenticated)
{
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">FS</span>
                <span class="brand-text">FieldSuite<span class="brand-sub">Construction Ops</span></span>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">Overview</div>
                <a class="nav-link @(Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i>Dashboard</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Projects") ? "active" : "")" asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open"></i>Projects</a>

                <div class="nav-section">Safety &amp; EHS</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Safety") ? "active" : "")" asp-controller="Safety" asp-action="Index"><i class="bi bi-shield-exclamation"></i>Incidents &amp; Near-Misses</a>
                <a class="nav-link @(Context.Request.Path == "/Safety/ToolboxTalks" ? "active" : "")" asp-controller="Safety" asp-action="ToolboxTalks"><i class="bi bi-chat-square-text"></i>Toolbox Talks</a>

                <div class="nav-section">Quality</div>
                <a class="nav-link @(Context.Request.Path == "/Quality" ? "active" : "")" asp-controller="Quality" asp-action="Index"><i class="bi bi-clipboard-check"></i>Snag / Punch List</a>
                <a class="nav-link @(Context.Request.Path == "/Quality/Inspections" ? "active" : "")" asp-controller="Quality" asp-action="Inspections"><i class="bi bi-search"></i>Inspections</a>
                <a class="nav-link @(Context.Request.Path == "/Quality/NCRs" ? "active" : "")" asp-controller="Quality" asp-action="NCRs"><i class="bi bi-exclamation-octagon"></i>NCRs</a>

                <div class="nav-section">Permits</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Permits") ? "active" : "")" asp-controller="Permits" asp-action="Index"><i class="bi bi-file-earmark-check"></i>Work Permits (ePTW)</a>

                <div class="nav-section">Estimation</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Estimation") ? "active" : "")" asp-controller="Estimation" asp-action="Index"><i class="bi bi-calculator"></i>Estimates &amp; BOQ</a>

                <div class="nav-section">Workforce</div>
                <a class="nav-link @(Context.Request.Path == "/Workforce" || Context.Request.Path == "/Workforce/Attendance" ? "active" : "")" asp-controller="Workforce" asp-action="Index"><i class="bi bi-calendar2-check"></i>Attendance</a>
                <a class="nav-link @(Context.Request.Path == "/Workforce/Workers" ? "active" : "")" asp-controller="Workforce" asp-action="Workers"><i class="bi bi-people"></i>Workers</a>
                <a class="nav-link @(Context.Request.Path == "/Workforce/Contractors" ? "active" : "")" asp-controller="Workforce" asp-action="Contractors"><i class="bi bi-briefcase"></i>Contractors</a>

                <div class="nav-section">Intelligence</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Assistant") ? "active" : "")" asp-controller="Assistant" asp-action="Index"><i class="bi bi-robot"></i>AI Assistant</a>

                <div class="nav-section">Help</div>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Documents") ? "active" : "")" asp-controller="Documents" asp-action="Index"><i class="bi bi-file-earmark-pdf"></i>User Documents</a>
            </nav>
            <div class="sidebar-foot">
                <span class="dot"></span>
                <span>System operational</span>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-context">
                    <button class="sidebar-toggle" type="button" id="sidebarToggle" aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
                    <span class="page-title">@title</span>
                    <span class="page-sub text-muted small d-none d-md-inline">Verma Construction</span>
                </div>
                <div class="topbar-actions">
                    @await Component.InvokeAsync("Notifications")
                    <div class="dropdown">
                        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@initials</span>
                            <span class="user-name">@Current.FullName</span>
                            <span class="role-pill">@Current.Role</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <div class="dropdown-header">
                                    <div class="fw-semibold">@Current.FullName</div>
                                    <small class="text-muted">@Current.Role</small>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] is string success && !string.IsNullOrEmpty(success))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i>@success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error && !string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>@error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.UtcNow.Year FieldSuite · Construction operations platform</span>
                <span>v1.0</span>
            </footer>
        </div>
    </div>
}
else
{
    <div class="auth-shell">
        @RenderBody()
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>