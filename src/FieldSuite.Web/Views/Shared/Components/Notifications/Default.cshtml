@using FieldSuite.Domain.Entities
@model IReadOnlyList<FieldSuite.Domain.Entities.Notification>
<div class="dropdown">
    <button class="bell-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
        <i class="bi bi-bell"></i>
        @if ((int)ViewBag.UnreadCount > 0)
        {
            <span class="count">@ViewBag.UnreadCount</span>
        }
    </button>
    <ul class="dropdown-menu dropdown-menu-end notifications-menu">
        <li><span class="notif-head">Notifications</span></li>
        @if (!Model.Any())
        {
            <li><span class="dropdown-item-text text-muted small px-2 py-3 d-block text-center">No notifications yet</span></li>
        }
        @foreach (var n in Model)
        {
            <li>
                <a class="dropdown-item notif-item d-flex flex-column align-items-start @(n.IsRead ? "" : "unread")" href="@n.Link">
                    <span>@n.Message</span>
                    <span class="notif-time">@n.CreatedAt.ToString("dd MMM HH:mm") UTC</span>
                </a>
            </li>
        }
    </ul>
</div>