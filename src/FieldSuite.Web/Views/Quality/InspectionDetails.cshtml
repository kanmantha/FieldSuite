@model FieldSuite.Domain.Entities.Inspection
@{
    ViewData["Title"] = $"Inspection {Model.Reference}";
    var finalized = Model.Status is InspectionStatus.Passed or InspectionStatus.Failed;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">@Model.Reference — @Model.Title</h4>
        <span class="text-muted small">@Model.Project?.Name · @Model.Type · @Model.InspectionDate.ToString("dd MMM yyyy") · @Model.Inspector?.FullName</span>
    </div>
    <div>
        <span class="badge bg-@(Model.Status == InspectionStatus.Passed ? "success" : Model.Status == InspectionStatus.Failed ? "danger" : Model.Status == InspectionStatus.Draft ? "secondary" : "warning text-dark") fs-6">@Model.Status</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Inspections">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold">Checklist</div>
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th style="width:45%">Item</th><th>Result</th><th>Comment</th><th style="width:190px">Action</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ChecklistText</td>
                        <td>
                            <span class="badge bg-@(item.Result == CheckResult.Pass ? "success" : item.Result == CheckResult.Fail ? "danger" : item.Result == CheckResult.N_A ? "secondary" : "secondary")">@item.Result</span>
                        </td>
                        <td class="small">@item.Comment</td>
                        <td>
                            @if (!finalized)
                            {
                                <form asp-action="InspectionItemResult" method="post" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <select name="result" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<CheckResult>()" style="width:120px"></select>
                                    <input name="comment" class="form-control form-control-sm" placeholder="Comment" style="width:110px" />
                                    <button class="btn btn-sm btn-outline-primary">Set</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted p-3">No checklist items yet.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @if (!finalized)
        {
            <div class="card mb-3">
                <div class="card-header bg-white fw-semibold">Add item</div>
                <div class="card-body">
                    <form asp-action="InspectionItemAdd" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="inspectionId" value="@Model.Id" />
                        <input name="checklistText" class="form-control form-control-sm" placeholder="e.g. Rebar spacing as per IFC drawing" required />
                        <button class="btn btn-sm btn-primary">Add</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Summary</div>
            <div class="card-body">
                @{
                    var pass = Model.Items.Count(i => i.Result == CheckResult.Pass);
                    var fail = Model.Items.Count(i => i.Result == CheckResult.Fail);
                    var na = Model.Items.Count(i => i.Result == CheckResult.N_A);
                }
                <div class="d-flex justify-content-between mb-2"><span>Pass</span><span class="badge bg-success">@pass</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Fail</span><span class="badge bg-danger">@fail</span></div>
                <div class="d-flex justify-content-between mb-3"><span>N/A</span><span class="badge bg-secondary">@na</span></div>
                @if (!finalized)
                {
                    <form asp-action="InspectionFinalize" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-sm btn-success w-100" onclick="return confirm('Finalize inspection? A fail marks it Failed and notifies the Site Manager.');">Finalize inspection</button>
                    </form>
                }
                else if (Model.Status == InspectionStatus.Failed)
                {
                    <p class="small text-danger mb-0">Inspection failed — raise snags from the Snag / Punch List.</p>
                    <a class="btn btn-sm btn-primary mt-2 w-100" asp-action="SnagCreate">+ Raise snag</a>
                }
            </div>
        </div>
    </div>
</div>
