@model IReadOnlyList<FieldSuite.Domain.Entities.Snag>
@{
    ViewData["Title"] = "Snag / Punch List";
    var projects = (SelectList)ViewBag.Projects;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Snag / Punch List</h4>
        <span class="text-muted small">@ViewBag.OpenCount open · @ViewBag.OverdueCount overdue</span>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="SnagCreate">+ Raise snag</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<SnagStatus>()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Project</label>
                <select name="projectId" class="form-select form-select-sm" asp-items="projects">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2"><button class="btn btn-sm btn-secondary">Filter</button></div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-hover table-sm mb-0 align-middle">
        <thead>
        <tr><th>Ref</th><th>Title</th><th>Project</th><th>Location</th><th>Priority</th><th>Due</th><th>Assignee</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            var overdue = s.DueDate != null && s.DueDate < DateTime.UtcNow.Date && s.Status != SnagStatus.Closed && s.Status != SnagStatus.Rejected;
            <tr>
                <td class="fw-semibold">@s.Reference</td>
                <td>@s.Title</td>
                <td class="small">@s.Project?.Name</td>
                <td class="small">@s.Location</td>
                <td><span class="badge bg-@(s.Priority switch { SnagPriority.Critical => "danger", SnagPriority.High => "warning text-dark", SnagPriority.Medium => "info text-dark", _ => "secondary" })">@s.Priority</span></td>
                <td class="small @(overdue ? "text-danger fw-bold" : "")">@(s.DueDate?.ToString("dd MMM") ?? "—")</td>
                <td class="small">@(s.AssignedTo?.FullName ?? "—")</td>
                <td><span class="badge bg-@(s.Status == SnagStatus.Closed ? "success" : s.Status == SnagStatus.Rejected ? "secondary" : "primary")">@s.Status</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="SnagDetails" asp-route-id="@s.Id">Open</a></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="9" class="text-muted p-3">No snags match the filter.</td></tr> }
        </tbody>
    </table>
</div>
