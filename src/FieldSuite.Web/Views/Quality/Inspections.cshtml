@model IReadOnlyList<FieldSuite.Domain.Entities.Inspection>
@{
    ViewData["Title"] = "Inspections";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">QA/QC Inspections</h4>
        <span class="text-muted small">Internal, client and third-party checks</span>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="InspectionCreate">+ New inspection</a>
</div>
<div class="card">
    <table class="table table-hover table-sm mb-0 align-middle">
        <thead><tr><th>Ref</th><th>Title</th><th>Project</th><th>Type</th><th>Date</th><th>Inspector</th><th>Items</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var i in Model)
        {
            var pass = i.Items.Count(x => x.Result == CheckResult.Pass);
            var fail = i.Items.Count(x => x.Result == CheckResult.Fail);
            <tr>
                <td class="fw-semibold">@i.Reference</td>
                <td>@i.Title</td>
                <td class="small">@i.Project?.Name</td>
                <td class="small">@i.Type</td>
                <td class="small">@i.InspectionDate.ToString("dd MMM")</td>
                <td class="small">@i.Inspector?.FullName</td>
                <td class="small"><span class="badge bg-success">@pass pass</span> <span class="badge bg-danger">@fail fail</span></td>
                <td><span class="badge bg-@(i.Status == InspectionStatus.Passed ? "success" : i.Status == InspectionStatus.Failed ? "danger" : i.Status == InspectionStatus.Draft ? "secondary" : "warning text-dark")">@i.Status</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="InspectionDetails" asp-route-id="@i.Id">Open</a></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="9" class="text-muted p-3">No inspections yet.</td></tr> }
        </tbody>
    </table>
</div>
