@model FieldSuite.Domain.Entities.Snag
@{
    ViewData["Title"] = $"Snag {Model.Reference}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">@Model.Reference — @Model.Title</h4>
        <span class="text-muted small">@Model.Project?.Name · @Model.Location</span>
    </div>
    <div>
        @if (Model.Status is not (SnagStatus.Closed or SnagStatus.Rejected))
        {
            <a class="btn btn-sm btn-outline-primary" asp-action="SnagEdit" asp-route-id="@Model.Id">Edit</a>
        }
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-body">
                <div class="row mb-2"><div class="col-4 detail-label">Status</div><div class="col-8"><span class="badge bg-@(Model.Status == SnagStatus.Closed ? "success" : "primary")">@Model.Status</span></div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Priority</div><div class="col-8"><span class="badge bg-@(Model.Priority switch { SnagPriority.Critical => "danger", SnagPriority.High => "warning text-dark", SnagPriority.Medium => "info text-dark", _ => "secondary" })">@Model.Priority</span></div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Description</div><div class="col-8">@Model.Description</div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Raised by</div><div class="col-8">@Model.RaisedBy?.FullName</div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Assigned to</div><div class="col-8">@(Model.AssignedTo?.FullName ?? "—")</div></div>
                <div class="row mb-2"><div class="col-4 detail-label">Due date</div><div class="col-8 @(Model.DueDate != null && Model.DueDate < DateTime.UtcNow.Date ? "text-danger" : "")">@(Model.DueDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                <div class="row"><div class="col-4 detail-label">Closed at</div><div class="col-8">@(Model.ClosedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</div></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <div class="card">
                <div class="card-header bg-white fw-semibold">Photo</div>
                <div class="card-body text-center">
                    <img src="~/@Model.PhotoPath" alt="Snag photo" class="img-fluid rounded" style="max-height:340px" />
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Workflow</div>
            <div class="card-body d-flex flex-wrap gap-2">
                @{
                    string[]? actions = Model.Status switch
                    {
                        SnagStatus.Open => new[] { "Assigned", "InProgress" },
                        SnagStatus.Assigned => new[] { "InProgress" },
                        SnagStatus.InProgress => new[] { "Retest" },
                        SnagStatus.Retest => new[] { "Closed", "Rejected" },
                        SnagStatus.Rejected => new[] { "Assigned" },
                        _ => Array.Empty<string>()
                    };
                }
                @foreach (var action in actions)
                {
                    var target = (SnagStatus)Enum.Parse(typeof(SnagStatus), action);
                    <form asp-action="SnagTransition" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="to" value="@((int)target)" />
                        <button class="btn btn-sm @(target == SnagStatus.Closed ? "btn-success" : target == SnagStatus.Rejected ? "btn-outline-danger" : "btn-primary")"
                                onclick="return confirm('Move to @action?');">@action</button>
                    </form>
                }
                @if (actions.Length == 0)
                {
                    <span class="text-muted small">No further transitions — this snag is @Model.Status.</span>
                }
            </div>
        </div>
    </div>
</div>
