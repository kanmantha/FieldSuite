@model IReadOnlyList<FieldSuite.Domain.Entities.NCR>
@{
    ViewData["Title"] = "Non-Conformance Reports";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Non-Conformance Reports</h4>
        <span class="text-muted small">Open → Containment → Investigation → Closed</span>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="NCRCreate">+ Raise NCR</a>
</div>
<div class="card">
    <table class="table table-hover table-sm mb-0 align-middle">
        <thead><tr><th>Ref</th><th>Title</th><th>Project</th><th>Severity</th><th>Detected</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td class="fw-semibold">@n.Reference</td>
                <td>@n.Title</td>
                <td class="small">@n.Project?.Name</td>
                <td><span class="badge bg-@(n.Severity == Severity.High || n.Severity == Severity.Critical ? "danger" : n.Severity == Severity.Medium ? "warning text-dark" : "secondary")">@n.Severity</span></td>
                <td class="small">@n.DetectedDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge bg-@(n.Status == NCRStatus.Closed ? "success" : "primary")">@n.Status</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="NCRDetails" asp-route-id="@n.Id">Open</a></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-muted p-3">No NCRs raised.</td></tr> }
        </tbody>
    </table>
</div>
